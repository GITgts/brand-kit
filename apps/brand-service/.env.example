PORT=3000
# One key per consuming app: "<app>:<key>,<app>:<key>"
BRAND_SERVICE_API_KEYS=wiseos:change-me
BRAND_RATE_LIMIT_PER_MIN=60
ANTHROPIC_API_KEY=
BRAND_VISION_MODEL=claude-sonnet-5
BRAND_MONOGRAM_FONT_PATH=/app/fonts/CrispyBrand-Bold.ttf
CHROMIUM_EXECUTABLE_PATH=
BRAND_MAX_CONCURRENT_RENDERS=2
BRAND_TOTAL_TIMEOUT_MS=45000
BRAND_CACHE_TTL_MS=86400000
BRAND_ALLOW_PRIVATE_NETWORK=false
