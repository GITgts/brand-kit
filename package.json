{
  "name": "brand-kit-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --filter './apps/*' build",
    "test": "pnpm build && pnpm -r test",
    "typecheck": "pnpm build && pnpm -r typecheck",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "pack:kit": "pnpm --filter @wisemen/brand-kit build && cd packages/brand-kit && pnpm pack --pack-destination ../../packs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}